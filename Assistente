        function getFormattedTime() {
            const now = new Date();
            return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        // Toggle Simulador Box
        function toggleSimulador(show) {
            const box = document.getElementById("simuladorBox");
            if (show) {
                box.classList.remove("hidden");
                box.scrollIntoView({ behavior: 'smooth' });
            } else {
                box.classList.add("hidden");
            }
        }

        // Adicionar Mensagem do Usuário na Tela
        function addUserMessage(text) {
            const chatContainer = document.getElementById("chatMessages");
            const timeStr = getFormattedTime();

            const msgDiv = document.createElement("div");
            msgDiv.className = "flex justify-end animate-msg";
            msgDiv.innerHTML = `
                <div class="relative bg-wa-lightgreen dark:bg-wa-darkmsg text-slate-800 dark:text-slate-100 p-3 rounded-xl rounded-tr-none shadow max-w-[85%] md:max-w-[75%] bubble-out">
                    <p class="text-sm leading-relaxed">${escapeHtml(text)}</p>
                    <div class="flex items-center justify-end space-x-1 mt-1">
                        <span class="text-[10px] text-slate-500 dark:text-emerald-200">${timeStr}</span>
                        <i class="fas fa-check-double text-[10px] text-sky-500"></i>
                    </div>
                </div>
            `;
            chatContainer.appendChild(msgDiv);
            scrollToBottom();
        }

        // Adicionar Mensagem da I.A Natália
        function addIAMessage(htmlContent) {
            const chatContainer = document.getElementById("chatMessages");
            const timeStr = getFormattedTime();

            // Simular "Digitando..." antes de responder
            const typingDiv = document.createElement("div");
            typingDiv.className = "flex justify-start animate-msg id-typing";
            typingDiv.innerHTML = `
                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl rounded-tl-none shadow border border-slate-200 dark:border-slate-700 flex items-center space-x-2">
                    <span class="text-xs text-slate-400 font-medium">Natália está digitando...</span>
                    <div class="flex space-x-1">
                        <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-bounce"></div>
                        <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                        <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                    </div>
                </div>
            `;
            chatContainer.appendChild(typingDiv);
            scrollToBottom();

            setTimeout(() => {
                typingDiv.remove();
                const msgDiv = document.createElement("div");
                msgDiv.className = "flex justify-start animate-msg";
                msgDiv.innerHTML = `
                    <div class="relative bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 p-3.5 rounded-xl rounded-tl-none shadow max-w-[85%] md:max-w-[75%] bubble-in border border-slate-200 dark:border-slate-700">
                        <p class="font-semibold text-emerald-700 dark:text-emerald-400 text-xs mb-1">Natália | KMHAKA</p>
                        <div class="text-sm leading-relaxed">${htmlContent}</div>
                        <span class="text-[10px] text-slate-400 float-right mt-1 ml-2">${timeStr}</span>
                    </div>
                `;
                chatContainer.appendChild(msgDiv);
                scrollToBottom();
            }, 800);
        }

        // Enviar mensagem digitada
        function sendUserMessage() {
            const input = document.getElementById("userMessageInput");
            const text = input.value.trim();
            if (!text) return;

            addUserMessage(text);
            input.value = "";
            processIAMatch(text);
        }

        // Tratar botões de ação rápida
        function triggerQuickReply(type) {
            let userText = "";
            if (type === 'vantagens') userText = "Quais são as características e vantagens da moto KMHAKA?";
            else if (type === 'valores') userText = "Qual o valor da moto e tem desconto?";
            else if (type === 'pagamento') userText = "Quais são as formas de pagamento disponíveis?";
            else if (type === 'endereco') userText = "Qual é o endereço da loja?";
            else if (type === 'simular') {
                addUserMessage("Gostaria de fazer uma simulação de parcelamento.");
                toggleSimulador(true);
                return;
            }

            addUserMessage(userText);
            processIAMatch(userText);
        }

        // Lógica da Inteligência Artificial Automática
        function processIAMatch(query) {
            const q = query.toLowerCase();

            // Respostas baseadas em palavras-chave
            if (q.includes("caracteristica") || q.includes("vantagem") || q.includes("autonomia") || q.includes("motor") || q.includes("cnh") || q.includes("ipva") || q.includes("garantia")) {
                const response = `
                    <b>⚡ Características Principais da KM-HAKA:</b><br><br>
                    ✅ <b>Motor:</b> 1000W potente<br>
                    ✅ <b>Autonomia:</b> Até 60 km por carga completa<br>
                    ✅ <b>Velocidade:</b> Até 32 km/h<br>
                    ✅ <b>Capacidade:</b> Suporta até 150 kg<br>
                    ✅ <b>Garantia:</b> 1 ano de garantia total<br>
                    ✅ <b>Sem IPVA:</b> Conforme a classificação do modelo, sem necessidade de CNH ou emplacamento!
                    <br><br>Gostaria de simular as parcelas para a sua compra?
                `;
                addIAMessage(response);
            } 
            else if (q.includes("valor") || q.includes("preco") || q.includes("preço") || q.includes("quanto custa") || q.includes("desconto") || q.includes("pix")) {
                const response = `
                    💰 <b>Valores da Moto Elétrica KM-HAKA:</b><br><br>
                    • <b>Valor Base:</b> R$ 10.999,00<br>
                    • <b>Pagamento via Pix:</b> <u>5% de Desconto</u> exclusivo! Fica por apenas <b>R$ 10.449,05</b> à vista.<br><br>
                    Para facilitar sua compra, aceitamos entrada + parcelamento. Deseja realizar uma simulação rápida agora?
                `;
                addIAMessage(response);
            }
            else if (q.includes("pagamento") || q.includes("forma") || q.includes("cartao") || q.includes("cartão") || q.includes("boleto") || q.includes("parcela")) {
                const response = `
                    💳 <b>Formas de Pagamento Facilitadas:</b><br><br>
                    ✅ Cartão de crédito em até <b>12x sem juros</b><br>
                    ✅ Entrada + saldo em até <b>10x sem juros</b> no cartão<br>
                    ✅ Boleto em até <b>36x</b>, com entrada a partir de R$ 500,00 (sujeito à análise de crédito).<br><br>
                    📍 <b>Nosso endereço:</b> Rua José Bonifácio, 364 - Bairro Leblon.<br><br>
                    Para eu calcular para você: informe o valor da entrada e em quantas parcelas prefere!
                `;
                addIAMessage(response);
            }
            else if (q.includes("onde") || q.includes("endereco") || q.includes("endereço") || q.includes("loja") || q.includes("bairro") || q.includes("fica")) {
                const response = `
                    📍 <b>Nosso Endereço:</b><br>
                    Rua José Bonifácio, 364 - Bairro Leblon.<br><br>
                    Venha nos fazer uma visita na Barboza Motors e faça um Test-Drive da KM-HAKA! 🛵💨
                `;
                addIAMessage(response);
            }
            else {
                // Resposta Padrão Inteligente da Natália
                const response = `
                    Olá! Sou a <b>Natália</b>, vendedora da <b>KMHAKA / Barboza Motors</b>. 🛵⚡<br><br>
                    A KM-HAKA custa <b>R$ 10.999,00</b> (com 5% de desconto no Pix por <b>R$ 10.449,05</b>).<br><br>
                    Possuímos opções em até 12x Sem Juros no Cartão ou em até 36x no Boleto (entrada a partir de R$ 500,00).<br><br>
                    Você pode clicar no botão <b>"Simular Parcelas"</b> ou me informar qual valor você pretende dar de entrada!
                `;
                addIAMessage(response);
            }
        }

        // Executar Simulação de Parcelamento Interativa
        function executarSimulacao() {
            const entradaVal = parseFloat(document.getElementById("inputEntrada").value) || 0;
            const parcelas = parseInt(document.getElementById("selectParcelas").value);
            const tipo = document.getElementById("selectTipo").value;

            if (entradaVal < 0) {
                alert("Por favor, insira um valor de entrada válido.");
                return;
            }

            if (tipo === 'boleto' && entradaVal < 500) {
                alert("Para modalidade Boleto, a entrada mínima é de R$ 500,00.");
                return;
            }

            const saldoRestante = VALOR_MOTO - entradaVal;
            if (saldoRestante <= 0) {
                alert("O valor da entrada cobre o valor total da moto! Recomendamos o pagamento via Pix com 5% de desconto (R$ 10.449,05).");
                return;
            }

            // Cálculo das parcelas (Sem juros para cartão até 12x, taxa simbólica para prazos maiores no boleto)
            let taxaJuros = (tipo === 'boleto' && parcelas > 12) ? 0.015 : 0; 
            let valorParcela = 0;

            if (taxaJuros > 0) {
                // Montante com juros simples para fins de simulação comercial
                valorParcela = (saldoRestante * (1 + (taxaJuros * (parcelas / 6)))) / parcelas;
            } else {
                valorParcela = saldoRestante / parcelas;
            }

            const entradaFmt = entradaVal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            const saldoFmt = saldoRestante.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            const parcelaFmt = valorParcela.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            const totalMotoFmt = VALOR_MOTO.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            // Mensagem do Usuário no Chat
            addUserMessage(`Simulação Realizada:\nEntrada: ${entradaFmt}\nParcelas: ${parcelas}x no ${tipo.toUpperCase()}`);

            // Fechar Caixa de Simulação
            toggleSimulador(false);

            // Mensagem formatada da Natália com resultado
            const respostaIA = `
                📊 <b>RESULTADO DA SUA SIMULAÇÃO - KM-HAKA</b><br><br>
                • <b>Valor Total Moto:</b> ${totalMotoFmt}<br>
                • <b>Entrada Informada:</b> <b class="text-emerald-600 dark:text-emerald-400">${entradaFmt}</b><br>
                • <b>Saldo a Financiar:</b> ${saldoFmt}<br>
                • <b>Plano Escolhido:</b> ${parcelas}x no ${tipo === 'cartao' ? 'Cartão de Crédito' : 'Boleto'}<br><br>
                🔥 <b>Fica em: ${parcelas}x de <span class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">${parcelaFmt}</span></b> ${tipo === 'cartao' && parcelas <= 12 ? '(Sem Juros)' : ''}<br><br>
                ${tipo === 'boleto' ? '<i>*Sujeito à análise de crédito.</i><br>' : ''}
                📍 <b>Endereço para fechar negócio:</b> Rua José Bonifácio, 364 - Bairro Leblon.<br><br>
                Clique no botão abaixo para enviar essa simulação diretamente para meu WhatsApp oficial <b>${NUMERO_FORMATADO}</b>!
                <div class="mt-3">
                    <a href="https://wa.me/${NUMERO_WHATSAPP}?text=Olá%20Natália,%20fiz%20uma%20simulação%20no%20site%20da%20KMHAKA:%0A- Entrada:%20${encodeURIComponent(entradaFmt)}%0A- Parcelamento:%20${parcelas}x%20de%20${encodeURIComponent(parcelaFmt)}%0A- Modalidade:%20${encodeURIComponent(tipo.toUpperCase())}%0AGostaria%20de%20dar%20andamento!" 
                       target="_blank" 
                       class="inline-flex items-center space-x-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-lg text-xs shadow-md transition w-full justify-center">
                        <i class="fab fa-whatsapp text-base"></i>
                        <span>Enviar Simulação no WhatsApp Real</span>
                    </a>
                </div>
            `;

            addIAMessage(respostaIA);
        }

        // Função utilitária Scroll Chat
        function scrollToBottom() {
            const chatMessages = document.getElementById("chatMessages");
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Helper para evitar XSS básico
        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;")
                       .replace(/</g, "&lt;")
                       .replace(/>/g, "&gt;")
                       .replace(/"/g, "&quot;")
                       .replace(/'/g, "&#039;");
        }
    </script>
</body>
