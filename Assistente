        const DESCONTO_PIX = 0.05; // 5%
        const VALOR_PIX = VALOR_MOTO * (1 - DESCONTO_PIX); // R$ 10.449,05
        const NUMERO_WHATSAPP = "5534992444249";
        const NUMERO_FORMATADO = "(34) 99244-4249";

        // Inicializar horários
        document.addEventListener("DOMContentLoaded", () => {
            const timeStr = getFormattedTime();
            document.getElementById("time1").innerText = timeStr;
            document.getElementById("time2").innerText = timeStr;
